{
  "name": "ConfiguracaoFinanceira",
  "type": "object",
  "properties": {
    "salario": {
      "type": "number",
      "description": "Sal\u00e1rio l\u00edquido (ap\u00f3s descontos)"
    },
    "salarioBruto": {
      "type": "number",
      "description": "Sal\u00e1rio bruto (antes dos descontos)"
    },
